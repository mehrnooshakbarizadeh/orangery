// react & next
import React from "react";

// external dependencies
import { Box, Typography } from "@mui/material";

// orangery elements & internal dependencies
import {
  OrangeryPrice,
  OrangeryDownloadContractsButton,
  OrangeryUserCircle
} from "../../../OrangeryElements";

// queries & backend
import { IOfferResult } from "../../../../queries/tenant";
import { IUser } from "../../../../queries/dashboard";

export default function RoomPreviewOffer({
  offer,
  customer
}: {
  offer?: IOfferResult | null
  customer?: IUser | null
}) {
  return (
    <>
      <Box
        sx={{
          display: "flex",
          flexDirection: "column",
          gap: 4,
          justifyContent: "center",
          backgroundColor: "#F8F8F8",
          borderRadius: 1,
          p: 2,
          mt: 4,
          width: "100%",
          // height: "90%",
          "& .column-align": {
            display: "flex",
            flexDirection: "column",
          },
        }}
      >
        <Box
          sx={{
            display: "flex",
            gap: 3,
            justifyContent: "space-between"
          }}
        >
          <Box className="column-align">
            <Typography variant="h6">OFFER NAME</Typography>
            <Typography variant="h4">
              {offer?.name}
            </Typography>
          </Box>
          <Box
            sx={{
              display: "flex",
              flexDirection: "row",
              gap: 3
            }}
          >
            <Box className="column-align">
              <Typography variant="h6">PRICE</Typography>
              <Typography variant="h6">
                <OrangeryPrice euro={offer?.price} germanFormat />/m
              </Typography>
            </Box>
            <Box className="column-align">
              <Typography variant="h6">SALE PRICE</Typography>
              <Typography variant="h4">
                <OrangeryPrice euro={parseFloat((offer?.sale_price ?? 0).toString()) > 0 ? offer?.sale_price : offer?.price} germanFormat />/m
              </Typography>
            </Box>
          </Box>
        </Box>
        <Box
          sx={{
            display: "flex",
            flexDirection: "row",
            gap: 3,
            justifyContent: "space-between"
          }}
        >
          {customer &&
            <Box className="column-align">
              <Typography variant="h6">CUSTOMER</Typography>
              <Box sx={{ display: "flex", gap: 0.5, alignItems: "center" }}>
                <OrangeryUserCircle
                  name={customer.name ?? customer.first_name + " " + customer.last_name}
                  fileName={customer?.image}
                  size={25}
                  noMargin
                />
                <Typography fontSize={16} fontWeight={700}>
                  {customer.name ?? customer.first_name + " " + customer.last_name}
                </Typography>
              </Box>
            </Box>
          }
          <Box className="column-align">
            <Typography variant="h6">CONTRACT DATE</Typography>
            <Box sx={{ display: "flex", gap: 1 }}>
              <Typography fontSize={16} fontWeight={700}>
                {offer?.contract_start_date
                  ? new Date(offer?.contract_start_date ?? "").toLocaleString(
                    "de-DE",
                    {
                      month: "long",
                      year: "numeric",
                      day: "numeric",
                    }
                  )
                  : "-"
                }
              </Typography>
              {offer?.contract_end_date &&
                <>
                  -
                  <Typography fontSize={16} fontWeight={700}>
                    {new Date(offer?.contract_end_date ?? "").toLocaleString(
                      "de-DE",
                      {
                        month: "long",
                        year: "numeric",
                        day: "numeric",
                      }
                    )}
                  </Typography>
                </>
              }
            </Box>
          </Box>
          {offer?.documents && offer?.documents?.length > 0 &&
            <Box
              sx={{
                mt: "auto"
              }}
            >
              <OrangeryDownloadContractsButton documents={offer?.documents} />
            </Box>
          }
        </Box>
      </Box>
    </>
  );
}
